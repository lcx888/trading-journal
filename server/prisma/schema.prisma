generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           String   @default("user")
  status         String   @default("active")
  emailVerified  Boolean  @default(false)
  verifyToken    String?
  verifyExpires  DateTime?
  resetToken     String?
  resetExpires   DateTime?
  rememberToken  String?
  lastLoginAt    DateTime?
  lastLoginIp    String?
  // 订阅相关
  subscriptionPlan String @default("free")  // free, basic, pro, enterprise
  subscriptionStatus String @default("active")  // active, canceled, expired, trial
  subscriptionExpiresAt DateTime?
  subscriptionCanceledAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  instruments  Instrument[]
  records      Record[]
  trades       Trade[]
  strategies   Strategy[]
  imports      ImportRecord[]
  reviews      Review[]
  aiAnalyses   AIAnalysis[]
  subscriptions Subscription[]
}

model Instrument {
  id             String   @id @default(uuid())
  userId         String
  code           String
  name           String
  feeRate        Float
  tickValue      Float
  initialCapital Float
  atasPattern    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
  @@index([userId])
}

model Record {
  id          String   @id
  userId      String
  name        String
  description String?
  status      String   @default("active")
  tradeCount  Int      @default(0)
  totalPnL    Float    @default(0)
  winRate     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  trades Trade[]

  @@index([userId])
}

model Trade {
  id             String   @id
  userId         String
  recordId       String?
  instrumentCode String?
  openTime       DateTime?
  pnl            Float?
  data           String
  source         String?   @default("atas")  // atas, jigsaw
  account        String?                     // 交易账户
  mae            Int?                        // Maximum Adverse Excursion (Jigsaw)
  mfe            Int?                        // Maximum Favorable Excursion (Jigsaw)
  fills          Int?                        // 成交次数 (Jigsaw)
  holdingSeconds Int?                        // 持仓时间（秒）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  record Record? @relation(fields: [recordId], references: [id])

  @@index([userId])
  @@index([recordId])
  @@index([instrumentCode])
  @@index([source])
  @@index([account])
}

model Strategy {
  id          String   @id
  userId      String
  name        String
  description String?
  color       String?
  category    String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ImportRecord {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  importDate DateTime
  tradesCount Int
  totalPnL   Float
  recordId   String?
  recordName String?
  fileType   String?  @default("atas")  // atas, jigsaw
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([fileType])
}

model Review {
  id        String   @id
  userId    String
  date      String
  type      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

model AIAnalysis {
  id             String   @id @default(uuid())
  userId         String
  recordId        String?
  recordName     String?
  title          String
  summary        String
  report         String
  totalTrades    Int
  totalPnL       Float
  winRate        Float
  profitFactor   Float
  maxDrawdown    Float
  dateRange      String?
  instruments    String?
  dataStartTime  DateTime?
  dataEndTime    DateTime?
  tradingDays    Int?
  overallScore   Int?
  overallLevel   String?
  avgProfit      Float?
  avgLoss        Float?
  profitLossRatio Float?
  sessionStats   String?
  instrumentStats String?
  directionStats String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  plan            String   // free, basic, pro, enterprise
  status          String   // active, canceled, expired, trial
  billingCycle    String   // monthly, yearly
  amount          Float    // 金额（分）
  currency        String   @default("CNY")
  startDate       DateTime
  endDate         DateTime?
  canceledAt      DateTime?
  cancelReason    String?
  paymentMethod   String?  // stripe, alipay, wechat
  paymentId       String?  // 第三方支付ID
  trialEndsAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([plan])
}

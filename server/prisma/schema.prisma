generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           String   @default("user")
  status         String   @default("active")
  emailVerified  Boolean  @default(false)
  verifyToken    String?
  verifyExpires  DateTime?
  resetToken     String?
  resetExpires   DateTime?
  rememberToken  String?
  lastLoginAt    DateTime?
  lastLoginIp    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  instruments   Instrument[]
  records       Record[]
  trades        Trade[]
  strategies    Strategy[]
  imports       ImportRecord[]
  reviews       Review[]
  aiAnalyses    AIAnalysis[]
  subscription  Subscription?
}

// 订阅计划
model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique          // free, pro, team
  displayName     String                    // 显示名称
  description     String?                   // 描述
  priceMonthly    Float    @default(0)      // 月费（美元）
  priceYearly     Float    @default(0)      // 年费（美元）
  
  // 功能限制
  maxRecords      Int      @default(1)      // 最大账本数
  maxTradesPerMonth Int    @default(100)    // 每月最大交易数
  maxHistoryDays  Int      @default(30)     // 历史数据保留天数
  maxAiAnalysisPerMonth Int @default(3)     // 每月 AI 分析次数
  maxTeamMembers  Int      @default(1)      // 团队成员数
  
  // 功能开关
  hasSmartDiagnosis   Boolean @default(false)  // 智能诊断
  hasMonteCarlo       Boolean @default(false)  // 蒙特卡洛模拟
  hasOptimalStopLoss  Boolean @default(false)  // 最优止损分析
  hasExpectancy       Boolean @default(false)  // 期望值分布
  hasBehaviorTags     Boolean @default(false)  // 行为归因标签
  hasExport           Boolean @default(false)  // 数据导出
  hasApi              Boolean @default(false)  // API 接口
  hasPrioritySupport  Boolean @default(false)  // 优先支持
  
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
}

// 用户订阅
model Subscription {
  id              String   @id @default(uuid())
  userId          String   @unique
  planId          String
  
  status          String   @default("active")  // active, cancelled, expired, trial
  billingCycle    String   @default("monthly") // monthly, yearly
  
  // 计费信息
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  
  // 使用统计（当月）
  tradesUsedThisMonth   Int @default(0)
  aiAnalysisUsedThisMonth Int @default(0)
  
  // 支付信息（预留 Stripe）
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id])
  plan SubscriptionPlan  @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

// 订阅历史/支付记录
model SubscriptionHistory {
  id              String   @id @default(uuid())
  userId          String
  planId          String
  action          String                  // created, upgraded, downgraded, renewed, cancelled
  fromPlan        String?
  toPlan          String?
  amount          Float    @default(0)
  currency        String   @default("USD")
  paymentMethod   String?
  paymentId       String?                 // Stripe payment ID
  note            String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 兑换码
model RedemptionCode {
  id              String   @id @default(uuid())
  code            String   @unique          // 兑换码（唯一）
  planName        String                    // 对应的订阅计划名称：pro, elite
  durationDays    Int                       // 订阅天数
  maxUses         Int      @default(1)      // 最大使用次数
  usedCount       Int      @default(0)      // 已使用次数
  isActive        Boolean  @default(true)   // 是否启用
  expiresAt       DateTime?                 // 过期时间（可选）
  note            String?                   // 备注
  createdBy       String?                   // 创建者 userId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     RedemptionRecord[]

  @@index([code])
  @@index([isActive])
}

// 兑换记录
model RedemptionRecord {
  id              String   @id @default(uuid())
  codeId          String                    // 兑换码 ID
  userId          String                    // 兑换用户 ID
  code            RedemptionCode @relation(fields: [codeId], references: [id])
  redeemedAt      DateTime @default(now())

  @@index([codeId])
  @@index([userId])
}

model Instrument {
  id             String   @id @default(uuid())
  userId         String
  code           String
  name           String
  feeRate        Float
  tickValue      Float
  initialCapital Float
  atasPattern    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
  @@index([userId])
}

model Record {
  id          String   @id
  userId      String
  name        String
  description String?
  status      String   @default("active")
  tradeCount  Int      @default(0)
  totalPnL    Float    @default(0)
  winRate     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  trades Trade[]

  @@index([userId])
}

model Trade {
  id             String   @id
  userId         String
  recordId       String?
  instrumentCode String?
  openTime       DateTime?
  pnl            Float?
  data           String
  source         String?   @default("atas")  // atas, jigsaw
  account        String?                     // 交易账户
  mae            Int?                        // Maximum Adverse Excursion (Jigsaw)
  mfe            Int?                        // Maximum Favorable Excursion (Jigsaw)
  fills          Int?                        // 成交次数 (Jigsaw)
  holdingSeconds Int?                        // 持仓时间（秒）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  record Record? @relation(fields: [recordId], references: [id])

  @@index([userId])
  @@index([recordId])
  @@index([instrumentCode])
  @@index([source])
  @@index([account])
}

model Strategy {
  id          String   @id
  userId      String
  name        String
  description String?
  color       String?
  category    String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ImportRecord {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  importDate DateTime
  tradesCount Int
  totalPnL   Float
  recordId   String?
  recordName String?
  fileType   String?  @default("atas")  // atas, jigsaw
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([fileType])
}

model Review {
  id        String   @id
  userId    String
  date      String
  type      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

model AIAnalysis {
  id             String   @id @default(uuid())
  userId         String
  recordId       String?
  recordName     String?
  title          String
  summary        String
  report         String
  totalTrades    Int
  totalPnL       Float
  winRate        Float
  profitFactor   Float
  maxDrawdown    Float
  dateRange      String?
  instruments    String?
  dataStartTime  DateTime?
  dataEndTime    DateTime?
  tradingDays    Int?
  overallScore   Int?
  overallLevel   String?
  avgProfit      Float?
  avgLoss        Float?
  profitLossRatio Float?
  sessionStats   String?
  instrumentStats String?
  directionStats String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
